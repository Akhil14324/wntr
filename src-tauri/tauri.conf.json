{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WNTR",
  "version": "0.1.0",
  "identifier": "com.akhil.wntr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WNTR",
        "url": "index.html",
        "width": 820,
        "height": 520,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Akhil14324",
    "shortDescription": "A dynamic notch for Windows",
    "longDescription": "WNTR puts a dynamic notch at the top of your screen with music, synced lyrics, a file shelf, focus timer, reminders and more.",
    "copyright": "MIT License",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2REU3MkIxNDQ3RTg1MDEKUldRQmhYNUVzWExlaGtvMkxLRzdzaEhpZG5hQ0hHMzcwd29iYU42cGIrZ0Znc2xYd2xKcWhhelYK",
      "endpoints": [
        "https://github.com/Akhil14324/wntr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
